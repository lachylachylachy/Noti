{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noti",
  "version": "0.1.0",
  "identifier": "com.lachy.noti",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Noti",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}